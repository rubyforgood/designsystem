{
  "name": "@rubyforgood/design-system",
  "version": "0.1.0",
  "description": "Ruby For Good's global design system: a normative spec tagged Portable/Local, Tailwind v4 design tokens, and an audit suite for migrating any app onto it.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/rubyforgood/designsystem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubyforgood/designsystem.git"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "accessibility",
    "a11y",
    "wcag",
    "tailwindcss",
    "audit"
  ],
  "files": [
    "tokens/",
    "bin/design/",
    "examples/reference-app/",
    "docs/portability/",
    "docs/field-notes.md",
    "design.md",
    "LICENSE",
    "components/README.md",
    "dist/"
  ],
  "exports": {
    "./components/button": {
      "default": "./dist/components/button.mjs"
    },
    "./components/button/standalone": {
      "default": "./dist/standalone/button.mjs"
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
